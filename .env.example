DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# 管理画面（/admin）のログインパスワード
ADMIN_PASSWORD=""
# 管理画面セッション署名用のランダムな文字列（openssl rand -hex 32 などで生成）
ADMIN_SESSION_SECRET=""

# Notion Integration Token（https://www.notion.so/my-integrations で発行）
NOTION_TOKEN=""
# 店舗一覧を管理するNotionデータベースのID
NOTION_STORES_DATABASE_ID=""
# 店舗をアプリに掲載するかのチェックボックスのプロパティ名（省略時は "クーポン対象"）
NOTION_STORES_ACTIVE_PROPERTY="クーポン対象"
